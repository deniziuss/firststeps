# Local development only. `npm run db:local:setup` creates .env.local with generated values.
# Never commit .env.local and never paste its values into chat or source code.

# Local SQL Server Express (TCP on 127.0.0.1:1433). Remote servers are rejected by the app.
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=FirstSteps_Dev
DB_USER=firststeps_app
DB_PASSWORD=
DB_ENCRYPT=true
# Local SQL Express uses a self-signed certificate.
DB_TRUST_SERVER_CERT=true

# Signs the session cookie. At least 32 random characters.
SESSION_SECRET=

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For (used for rate limiting).
TRUST_PROXY=false
# Number of trusted reverse proxies in front of the app (the client is read that many entries from the right).
TRUST_PROXY_HOPS=1

# Written by `npm run db:seed-users` for the synthetic admin/mentor accounts used in local tests.
# DEV_ADMIN_EMAIL=
# DEV_ADMIN_PASSWORD=
# DEV_MENTOR_EMAIL=
# DEV_MENTOR_PASSWORD=

# Deployment mode. `public` turns on the production checks (https APP_URL, real mail transport,
# encrypted and certificate-checked database connection, TRUST_PROXY=true) and the Host/HTTPS checks.
DEPLOYMENT=local
# Absolute base URL for links in emails (never taken from the request).
APP_URL=http://localhost:3000

# Email: outbox (development, JSON files in MAIL_OUTBOX_DIR), smtp, or disabled. See docs/email.md.
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=.mail-outbox
MAIL_FROM=FirstSteps <no-reply@firststeps.invalid>
# Only for MAIL_TRANSPORT=smtp (credentials from the provider; never commit them).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_REQUIRE_TLS=true

# Enables GET /api/metrics with `Authorization: Bearer <token>` (at least 32 characters). Unset: 404.
# METRICS_TOKEN=
